{% extends 'layout/base.twig' %}

{% block title %}500 — Server xətası{% endblock %}

{% block content %}
<section class="error-page">
  <div class="error-page__inner">
    <div class="error-page__emoji" aria-hidden="true">😵</div>
    <h1 class="error-page__code text-grad">500</h1>
    <h2 class="error-page__title">Daxili server xətası</h2>
    <p class="error-page__sub">
      Bizim tərəfimizdə nəsə düz getmədi. Bir az sonra yenidən cəhd et — komandamız xəbərdar edildi.
    </p>

    {% if debug is defined and debug and message is defined and message %}
      <pre class="error-page__debug"><code>{{ message }}</code></pre>
    {% endif %}

    <div class="error-page__cta">
      <a href="/" class="btn btn--primary btn--lg">
        <i data-lucide="home"></i>
        <span>Ana səhifəyə qayıt</span>
      </a>
      <button type="button" class="btn btn--ghost btn--lg" onclick="location.reload()">
        <i data-lucide="rotate-ccw"></i>
        <span>Yenilə</span>
      </button>
    </div>
  </div>
</section>
{% endblock %}
