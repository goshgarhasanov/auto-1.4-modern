<?xml version="1.0"?>
<ruleset name="auto-1.4-modern">
    <description>PSR-12 coding standard for auto 1.4 — Modern Edition.</description>

    <!-- Tarama qovluqları -->
    <file>app</file>
    <file>config</file>
    <file>routes</file>
    <file>tests</file>
    <file>public/index.php</file>

    <!-- Xaric edilənlər -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/legacy/*</exclude-pattern>
    <exclude-pattern>*/storage/*</exclude-pattern>
    <exclude-pattern>*/database/migrations/*</exclude-pattern>
    <exclude-pattern>*/views/*</exclude-pattern>
    <exclude-pattern>*/public/assets/*</exclude-pattern>

    <!-- Standart -->
    <rule ref="PSR12"/>

    <!-- Konfiqurasiya -->
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg value="np"/>

    <!-- Sətir uzunluğu -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="160"/>
        </properties>
    </rule>

    <!-- Ümumi keyfiyyət qaydaları -->
    <rule ref="Generic.PHP.DisallowShortOpenTag.EchoFound"/>
    <rule ref="Generic.PHP.ForbiddenFunctions">
        <properties>
            <property name="forbiddenFunctions" type="array">
                <element key="var_dump" value="null"/>
                <element key="print_r"  value="null"/>
                <element key="dd"       value="null"/>
                <element key="dump"     value="null"/>
            </properties>
        </properties>
    </rule>

    <!-- Test fayllarında forbidden function-lar icazəlidir -->
    <rule ref="Generic.PHP.ForbiddenFunctions">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
