{
    "name": "goshgaraz/auto-1.4-modern",
    "description": "Goshgar.Az chat — modern Slim 4 bootstrap with legacy bridge.",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Goshgar Hasanzadeh"
        }
    ],
    "require": {
        "php": ">=8.2",
        "slim/slim": "^4.14",
        "slim/twig-view": "^3.4",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/var-dumper": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php",
            "app/Support/LegacyShim.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public public/index.php",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
