<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}chat-app{% endblock %}</title>
    <link rel="stylesheet" href="/assets/css/app.css">
    <style>
        :root {
            --grad-from: #667eea;
            --grad-to:   #764ba2;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: #f5f7fb;
            color: #222;
        }
        header.app-header {
            background: linear-gradient(135deg, var(--grad-from), var(--grad-to));
            color: #fff;
            padding: 1.25rem 2rem;
            box-shadow: 0 2px 12px rgba(0,0,0,.08);
        }
        header.app-header .bar {
            display: flex; align-items: center; justify-content: space-between;
            max-width: 1100px; margin: 0 auto;
        }
        header.app-header a { color: #fff; text-decoration: none; opacity: .9; }
        header.app-header a:hover { opacity: 1; }
        header.app-header h1 { margin: 0; font-size: 1.4rem; letter-spacing: .5px; }
        nav.app-nav a { margin-left: 1rem; }
        main.container {
            max-width: 1100px; margin: 2rem auto; padding: 0 1.5rem;
        }
        .card {
            background: #fff; border-radius: 12px;
            padding: 1.5rem 1.75rem; margin-bottom: 1.25rem;
            box-shadow: 0 4px 18px rgba(20,30,80,.06);
        }
        .stat { display: flex; gap: 1rem; align-items: baseline; }
        .stat .num { font-size: 2.25rem; font-weight: 700; color: var(--grad-to); }
        form.app-form { display: grid; gap: .85rem; max-width: 380px; }
        form.app-form input, form.app-form select {
            padding: .65rem .8rem; border: 1px solid #d6dbe7;
            border-radius: 8px; font-size: 1rem; background: #fff;
        }
        form.app-form input:focus, form.app-form select:focus {
            outline: none; border-color: var(--grad-from);
            box-shadow: 0 0 0 3px rgba(102,126,234,.18);
        }
        form.app-form button {
            background: linear-gradient(135deg, var(--grad-from), var(--grad-to));
            color: #fff; border: 0; padding: .7rem 1rem;
            border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 1rem;
        }
        form.app-form button:hover { filter: brightness(1.05); }
        .alert { padding: .75rem 1rem; border-radius: 8px; margin-bottom: 1rem; }
        .alert-error { background: #ffe5e9; color: #8a1a2b; border: 1px solid #f5b8c2; }
        .alert-warn  { background: #fff5d6; color: #6a4a00; border: 1px solid #f0d480; }
        footer.app-footer { text-align: center; padding: 2rem 1rem; color: #8a8fa3; font-size: .9rem; }
        @media (max-width: 600px) {
            header.app-header { padding: 1rem; }
            main.container { padding: 0 1rem; margin-top: 1rem; }
        }
    </style>
    {% block head %}{% endblock %}
</head>
<body>
<header class="app-header">
    <div class="bar">
        <h1><a href="/">chat-app</a></h1>
        <nav class="app-nav">
            {% if current_user %}
                <a href="/profile">{{ current_user }}</a>
                <a href="/logout">Logout</a>
            {% else %}
                <a href="/login">Login</a>
                <a href="/register">Register</a>
            {% endif %}
        </nav>
    </div>
</header>
<main class="container">
    {% block content %}{% endblock %}
</main>
<footer class="app-footer">
    chat-app &middot; modern rewrite
</footer>
</body>
</html>
