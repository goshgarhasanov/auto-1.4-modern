{% extends 'layout/base.html.twig' %}
{% block title %}Profile - chat-app{% endblock %}
{% block content %}
    <div class="card" style="max-width:560px;margin:2rem auto">
        <h2 style="margin-top:0">Profile</h2>
        {% if user %}
            <p><strong>Username:</strong> {{ user.username }}</p>
            <p><strong>ID:</strong> {{ user.id }}</p>
            {% if user.sex %}<p><strong>Sex:</strong> {{ user.sex }}</p>{% endif %}
            {% if user.time %}<p><strong>Last seen:</strong> {{ user.time }}</p>{% endif %}
            <p><a href="/logout">Logout</a></p>
        {% else %}
            <p>You are not logged in. <a href="/login">Login</a>.</p>
        {% endif %}
    </div>
{% endblock %}
