{% extends 'layout/base.html.twig' %}
{% block title %}Home - chat-app{% endblock %}
{% block content %}
    {% if not db_ok %}
        <div class="alert alert-warn">Database is unreachable. Check your <code>.env</code>.</div>
    {% endif %}

    <div class="card">
        <div class="stat">
            <div class="num">{{ online_count }}</div>
            <div>users online (recent activity)</div>
        </div>
    </div>

    <div class="card">
        <h2 style="margin-top:0">Latest news</h2>
        {% for item in news %}
            <article style="margin-bottom:1rem">
                <h3 style="margin:.25rem 0">{{ item.title }}</h3>
                <p style="margin:.25rem 0;color:#555">{{ item.body }}</p>
            </article>
        {% else %}
            <p>No news yet.</p>
        {% endfor %}
    </div>

    {% if not user %}
        <div class="card">
            <h2 style="margin-top:0">Sign in</h2>
            <form class="app-form" method="post" action="/login">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <input type="text" name="username" placeholder="Username" required autocomplete="username">
                <input type="password" name="password" placeholder="Password" required autocomplete="current-password">
                <button type="submit">Login</button>
            </form>
            <p style="margin-top:1rem">No account? <a href="/register">Create one</a>.</p>
        </div>
    {% else %}
        <div class="card">
            <p>Signed in as <strong>{{ user.username }}</strong>. <a href="/profile">Open profile</a>.</p>
        </div>
    {% endif %}
{% endblock %}
