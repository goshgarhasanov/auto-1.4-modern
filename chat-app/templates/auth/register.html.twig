{% extends 'layout/base.html.twig' %}
{% block title %}Register - chat-app{% endblock %}
{% block content %}
    <div class="card" style="max-width:480px;margin:2rem auto">
        <h2 style="margin-top:0">Create account</h2>
        {% if error %}<div class="alert alert-error">{{ error }}</div>{% endif %}
        <form class="app-form" method="post" action="/register">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="text" name="username" placeholder="Username" value="{{ username|default('') }}" required minlength="3" maxlength="32" autocomplete="username">
            <input type="password" name="password" placeholder="Password (min 4 chars)" required minlength="4" autocomplete="new-password">
            <select name="sex">
                <option value="">Prefer not to say</option>
                <option value="m">Male</option>
                <option value="f">Female</option>
            </select>
            <button type="submit">Register</button>
        </form>
        <p style="margin-top:1rem">Already have an account? <a href="/login">Login</a>.</p>
    </div>
{% endblock %}
