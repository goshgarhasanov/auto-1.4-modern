{
    "name": "goshgar/chat-app",
    "description": "Modern PHP 8.3 chat application (parallel rewrite of legacy chat).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "slim/slim": "^4.13",
        "slim/psr7": "^1.6",
        "slim/twig-view": "^3.4",
        "twig/twig": "^3.10",
        "php-di/php-di": "^7.0",
        "monolog/monolog": "^3.5",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
