function shch( $msg )
{
$msg = substr( $msg, 0, 320 );
$msg = str_replace( "ch", "&#231;", $msg );
$msg = str_replace( "gh", "&#287;", $msg );
$msg = str_replace( "sh", "&#351;", $msg );
$msg = str_replace( "w", "&#351;", $msg );
$msg = str_replace( "W", "&#350;", $msg );
return $msg;
}

